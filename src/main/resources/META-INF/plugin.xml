<idea-plugin>
    <id>com.zhangwenbing.claude</id>
    <name>Claude Code Terminal</name>
    <version>1.1.0</version>

    <vendor email="wenbing@mgtv.com">wenbing</vendor>

    <!-- 兼容范围：242+ 覆盖 2024.2 起的大多数版本。后续可再调大/小。 -->
    <idea-version since-build="242.0"/>

    <description><![CDATA[
A terminal integration plugin for Claude Code CLI. This plugin provides a tool window to run and interact with Claude Code directly within JetBrains IDEs.

<i>Disclaimer: This plugin is an independent project and is not affiliated with, endorsed by, or sponsored by Anthropic.</i>
]]></description>

    <change-notes><![CDATA[

]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Claude Code"
                anchor="right"
                factoryClass="com.zhangwenbing.claude.ClaudeCodeToolWindowFactory"
                canCloseContents="false"
                icon="/icons/agent.svg"/>
        <notificationGroup
                id="claude.code.notifications"
                displayType="BALLOON"
                isLogByDefault="true"/>
        <!-- Settings -> Tools -> Claude Code Terminal -->
        <applicationConfigurable
                parentId="tools"
                instance="com.zhangwenbing.claude.ClaudeCodeConfigurable"
                id="claude.code.settings"
                displayName="Claude Code Terminal"/>
        <!-- VFS 刷新服务：负责防抖调度和执行实际的 VFS 刷新操作 -->
        <applicationService
                serviceImplementation="com.zhangwenbing.claude.ClaudeCodeVfsRefreshService"/>
        <!-- VFS 异步监听器：接收 VFS 事件并委托给 Service 处理 -->
        <vfs.asyncListener
                implementation="com.zhangwenbing.claude.ClaudeCodeVfsAsyncListener"/>
    </extensions>

    <actions>
        <!-- 编辑器右键菜单：发送文件引用 -->
        <group id="ClaudeCode.EditorGroup">
            <separator/>
            <group id="ClaudeCode.EditorActionGroup"
                   text="Claude Actions"
                   description="Claude Code actions"
                   popup="true">
                <action id="ClaudeCode.SendToClaude"
                        class="com.zhangwenbing.claude.SendToClaudeTerminalAction"
                        text="Send to Claude Code Terminal"
                        description="Send file reference (e.g. file.java:L1-5) to Claude Code Terminal"
                        icon="/icons/agent.svg">
                </action>
            </group>
            <separator/>
            <add-to-group group-id="BasicEditorPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="first"/>
        </group>

        <!-- 终端右键菜单：发送选中文本 -->
        <group id="ClaudeCode.ConsoleGroup">
            <separator/>
            <group id="ClaudeCode.ConsoleActionGroup"
                   text="Claude Actions"
                   description="Claude Code actions"
                   popup="true">
                <action id="ClaudeCode.SendConsoleSelectionToClaude"
                        class="com.zhangwenbing.claude.SendConsoleSelectionToClaudeAction"
                        text="Send to Claude Code Terminal"
                        description="Send selected text from console to Claude Code Terminal"
                        icon="/icons/agent.svg">
                </action>
            </group>
            <separator/>
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="first"/>
        </group>
    </actions>
</idea-plugin>
