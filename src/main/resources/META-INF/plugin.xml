<idea-plugin>
    <id>com.zhangwenbing.agent</id>
    <name>Agent Terminal</name>
    <version>1.2.0</version>

    <vendor email="wenbing@mgtv.com">wenbing</vendor>

    <!-- 兼容范围：243+ 覆盖 2024.3 起的新版终端。后续可再调大/小。 -->
    <idea-version since-build="243.0"/>

    <description><![CDATA[
A terminal integration plugin for Agent CLI (such as agy, claude, opencode). This plugin provides a tool window to run and interact with your AI agent directly within JetBrains IDEs.
]]></description>

    <change-notes><![CDATA[
<h3>1.2.0</h3>
<ul>
    <li>插件全面更名为 Agent Terminal，默认启动命令调整为 agy。</li>
    <li>全新设计 Agent 风格图标。</li>
    <li>支持从新版终端（New Terminal）选中输出内容或命令提示符直接发送至 Agent Terminal。</li>
    <li>接入 Terminal.OutputContextMenu 与 Terminal.PromptContextMenu 原生终端右键菜单。</li>
    <li>遵循现代 IntelliJ Platform 规范，全面适配 ActionUpdateThread.BGT，提升界面响应效率。</li>
</ul>
]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Agent"
                anchor="right"
                factoryClass="com.zhangwenbing.claude.ClaudeCodeToolWindowFactory"
                canCloseContents="false"
                icon="/icons/agent.svg"/>
        <notificationGroup
                id="agent.terminal.notifications"
                displayType="BALLOON"
                isLogByDefault="true"/>
        <!-- Settings -> Tools -> Agent Terminal -->
        <applicationConfigurable
                parentId="tools"
                instance="com.zhangwenbing.claude.ClaudeCodeConfigurable"
                id="agent.terminal.settings"
                displayName="Agent Terminal"/>
        <!-- VFS 刷新服务：负责防抖调度和执行实际的 VFS 刷新操作 -->
        <applicationService
                serviceImplementation="com.zhangwenbing.claude.ClaudeCodeVfsRefreshService"/>
        <!-- VFS 异步监听器：接收 VFS 事件并委托给 Service 处理 -->
        <vfs.asyncListener
                implementation="com.zhangwenbing.claude.ClaudeCodeVfsAsyncListener"/>
    </extensions>

    <actions>
        <!-- 编辑器右键菜单：发送文件引用 -->
        <group id="Agent.EditorGroup">
            <separator/>
            <group id="Agent.EditorActionGroup"
                   text="Agent Actions"
                   description="Agent actions"
                   popup="true">
                <action id="Agent.SendToAgent"
                        class="com.zhangwenbing.claude.SendToClaudeTerminalAction"
                        text="Send to Agent Terminal"
                        description="Send file reference (e.g. file.java:L1-5) to Agent Terminal"
                        icon="/icons/agent.svg">
                </action>
            </group>
            <separator/>
            <add-to-group group-id="BasicEditorPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="first"/>
        </group>

        <!-- 终端与控制台右键菜单：发送选中文本 -->
        <group id="Agent.ConsoleGroup">
            <separator/>
            <group id="Agent.ConsoleActionGroup"
                   text="Agent Actions"
                   description="Agent actions"
                   popup="true">
                <action id="Agent.SendConsoleSelectionToAgent"
                        class="com.zhangwenbing.claude.SendConsoleSelectionToClaudeAction"
                        text="Send to Agent Terminal"
                        description="Send selected text to Agent Terminal"
                        icon="/icons/agent.svg">
                </action>
            </group>
            <separator/>
            <!-- 控制台右键菜单（Run / Debug 等输出控制台） -->
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="first"/>
            <!-- 2025/2026 重制版终端右键菜单（Reworked Terminal Context Menu） -->
            <add-to-group group-id="Terminal.ReworkedTerminalContextMenu" anchor="first"/>
            <!-- 新版终端输出区右键菜单 -->
            <add-to-group group-id="Terminal.OutputContextMenu" anchor="first"/>
            <!-- 新版终端命令提示区右键菜单 -->
            <add-to-group group-id="Terminal.PromptContextMenu" anchor="first"/>
        </group>
    </actions>
</idea-plugin>
